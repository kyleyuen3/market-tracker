# Copy this file to .env in the server/ directory and fill in your values.
# .env is gitignored — your keys will never be committed.

# Which live market-data provider(s) to try, in order, as a comma-separated
# list. Each is tried in turn (e.g. so a rate-limited Alpha Vantage falls
# through to Finnhub) before the server falls back to simulated data.
#   stooq        - free, no key required, but blocked by some restrictive
#                  network policies (e.g. locked-down sandboxes).
#   alphavantage - requires ALPHA_VANTAGE_API_KEY below. 25 requests/day
#                  on the free tier.
#   finnhub      - requires FINNHUB_API_KEY below. 60 requests/minute on
#                  the free tier, but no free historical daily candles.
#
# Examples:
#   MARKET_DATA_PROVIDERS=stooq
#   MARKET_DATA_PROVIDERS=alphavantage,finnhub
#   MARKET_DATA_PROVIDERS=alphavantage,finnhub,stooq
#
# MARKET_DATA_PROVIDER (singular) also works for a single provider and is
# kept for backwards compatibility.
MARKET_DATA_PROVIDERS=stooq

# Required only when alphavantage is in MARKET_DATA_PROVIDERS.
# Get a free key at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# How long (ms) to cache each symbol's quote/history before re-fetching.
# Alpha Vantage's free tier allows only 25 requests/day and 5/minute, and
# this app polls every 20s and requests every distinct symbol on screen
# (indices + holdings + watchlist) each time — so a short cache will burn
# through the daily quota within minutes. Default is 5 minutes; consider
# raising this (e.g. 900000 = 15 min, or higher) if you're on the free tier.
ALPHA_VANTAGE_CACHE_TTL_MS=300000

# Required only when finnhub is in MARKET_DATA_PROVIDERS.
# Get a free key at https://finnhub.io/register (no credit card required).
FINNHUB_API_KEY=

# How long (ms) to cache each Finnhub quote before re-fetching. Finnhub's
# free tier is generous (60 req/min) so the default is short.
FINNHUB_CACHE_TTL_MS=30000

# Server port (optional).
PORT=4000
